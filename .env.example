# Required: IP or FQDN of the Wazuh manager
WAZUH_MANAGER_SERVER=

# Agent image tag. Must be <= the manager version.
WAZUH_VERSION=4.14.7

# rsyslog/rsyslog-collector tag. Release tags are 20yy-mm (rsyslog 8.yymm.0).
# Check https://hub.docker.com/r/rsyslog/rsyslog-collector/tags and pin one.
RSYSLOG_TAG=latest

# Optional
WAZUH_MANAGER_PORT=1514
# Defaults to WAZUH_MANAGER_SERVER when empty
WAZUH_REGISTRATION_SERVER=
WAZUH_REGISTRATION_PORT=1515
# Only if authd password enrollment is enabled on the manager
WAZUH_REGISTRATION_PASSWORD=
WAZUH_AGENT_NAME=syslog-collector
WAZUH_AGENT_GROUP=default

# Host port devices send syslog to (udp and tcp)
SYSLOG_PORT=514
# Rotate all.log at this size, keep this many compressed copies
SYSLOG_ROTATE_MB=100
SYSLOG_ROTATE_KEEP=5
TZ=America/Los_Angeles
